  * smb-reg.h on the 0x1000 base of pmi8998.dtsi:
@@ -285,7 +286,7 @@ sp_write_allowed(unsigned sid, unsigned addr, unsigned len)
 	}
 	if (sid == 0) {
 		/* PON spare (reboot reason); RTC alarm data 0x6140-0x6143 (the RTC offset, sweet_rtc_set) */
-		return (addr == 0x088fu && len == 1) || (addr >= 0x6140u && addr + len <= 0x6144u);
+		return ((addr == 0x088fu || addr == 0x0870u) && len == 1) || (addr >= 0x6140u && addr + len <= 0x6144u);
 	}
 	if (sid != 3) {
