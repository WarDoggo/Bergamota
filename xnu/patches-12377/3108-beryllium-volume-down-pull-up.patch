From: Poco F1 iOS port
Subject: [PATCH] keys: the volume-down key's pull-up, as Android sets it

During a listen at full volume the volume-down key (PM8998 RESIN, read from PON_RT_STS every 20 ms, a change taken
after three equal reads) reported 7 presses of 83-144 ms in 33 s while the user held the phone, and nobody pressed it:
iOS stepped the media volume down from full each time. With the phone lying still, 30 s of loud tones at full volume
gave no key events at all.

Android's pon driver switches the key's pull-up on at every start (pm8998.dtsi resin node: bias-pull-up; Linux
pm8941-pwrkey.c writes PON_PULL_CTL bit 0). This port never wrote the pull-ups. The key thread now reads
PON_PULL_CTL and PON_DBC_CTL at start, logs them, and sets bit 0 if it is clear, read-modify-write through
sweet_spmi_write, whose whitelist gains that one byte. kern.sweet_keys_pon_pull and kern.sweet_keys_pon_pull_now give
the value found and the value left.

diff --git a/bsd/dev/sweet_keys.c b/bsd/dev/sweet_keys.c
index 73d95f3..285d15e 100755
--- a/bsd/dev/sweet_keys.c
+++ b/bsd/dev/sweet_keys.c
@@ -5,6 +5,8 @@
  * volume-up on PM8998 GPIO6 (SID 0, 0xc500; mainline gpio-keys).
  * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
  * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ * One exception (3108, Poco F1): at start, the volume-down pull-up in
+ * PON_PULL_CTL is switched on when found off, through sweet_spmi_write.
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
 #include <sys/param.h>
@@ -16,6 +18,7 @@
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
 #include "sweet_board.h"
+#include "sweet_spmi.h"
 extern void thread_set_thread_name(thread_t th, const char *name);
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
@@ -49,6 +52,12 @@ static int keys_use_lock = 1;
 SYSCTL_UINT(_kern, OID_AUTO, sweet_keys_glitches, CTLFLAG_RD | CTLFLAG_LOCKED, &keys_glitches, 0, "key reads that did not last, ignored");
 SYSCTL_UINT(_kern, OID_AUTO, sweet_keys_read_errors, CTLFLAG_RD | CTLFLAG_LOCKED, &keys_read_errors, 0, "failed key reads");
 SYSCTL_INT(_kern, OID_AUTO, sweet_keys_lock, CTLFLAG_RW | CTLFLAG_LOCKED, &keys_use_lock, 0, "key polling takes the SPMI lock");
+/* 3108: PON_PULL_CTL as found at start and as left (0x100: not read) */
+static unsigned keys_pon_pull = 0x100u, keys_pon_pull_now = 0x100u;
+SYSCTL_UINT(_kern, OID_AUTO, sweet_keys_pon_pull, CTLFLAG_RD | CTLFLAG_LOCKED, &keys_pon_pull, 0,
+    "PM8998 PON_PULL_CTL at start: bit 0 volume-down pull-up, bit 1 power");
+SYSCTL_UINT(_kern, OID_AUTO, sweet_keys_pon_pull_now, CTLFLAG_RD | CTLFLAG_LOCKED, &keys_pon_pull_now, 0,
+    "PM8998 PON_PULL_CTL after the key thread's start");
 
 static uint32_t
 keys_rd(vm_offset_t base, uint32_t off)
@@ -110,6 +119,44 @@ keys_wait(void)
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
+/*
+ * 3108 (Poco F1): the volume-down key (PM8998 RESIN) reported 7 presses of 83-144 ms in 33 s while the user held the
+ * phone and music played, and nobody pressed it: the media volume stepped down from full (2026-11-07). With the phone
+ * lying still, loud sound gave none. Android's pon driver switches the key's pull-up on at every start (pm8998.dtsi
+ * resin: bias-pull-up; pm8941-pwrkey.c, PON_PULL_CTL bit 0); this port never did. Log the pull-ups and the debounce,
+ * and switch the volume-down pull-up on if it is off. Nothing else in PON is written.
+ */
+#define KEYS_PON_SUBTYPE 0x0805u
+#define KEYS_PON_PULL    0x0870u        /* PON_PULL_CTL: bit 0 RESIN (volume down), bit 1 KPDPWR (power), bit 2 CBLPWR */
+#define KEYS_PON_DBC     0x0871u        /* PON_DBC_CTL: bits 0-2, 15.6 ms << n */
+
+static void
+keys_pon_pull_up(void)
+{
+	uint8_t sub = 0, pull = 0, dbc = 0, back = 0;
+	if (!sweet_board_beryllium()) {
+		return;
+	}
+	if (sweet_spmi_init() != 0 || sweet_spmi_read(0, KEYS_PON_SUBTYPE, &sub) != 0 ||
+	    sweet_spmi_read(0, KEYS_PON_PULL, &pull) != 0 || sweet_spmi_read(0, KEYS_PON_DBC, &dbc) != 0) {
+		printf("SWEET KEYS: PON pull-ups not readable\n");
+		return;
+	}
+	keys_pon_pull = keys_pon_pull_now = pull;
+	printf("SWEET KEYS: PON subtype %#x, pull-ups %#x (volume-down %s, power %s), debounce %#x\n",
+	    sub, pull, (pull & 1u) ? "on" : "OFF", (pull & 2u) ? "on" : "OFF", dbc);
+	if (pull & 1u) {
+		return;
+	}
+	uint8_t want = (uint8_t)(pull | 1u);
+	int e = sweet_spmi_write(0, KEYS_PON_PULL, &want, 1);
+	if (sweet_spmi_read(0, KEYS_PON_PULL, &back) == 0) {
+		keys_pon_pull_now = back;
+	}
+	printf("SWEET KEYS: volume-down pull-up switched on (write %s), pull-ups now %#x\n", e == 0 ? "ok" : "failed",
+	    keys_pon_pull_now);
+}
+
 static void
 keys_thread(void *arg, wait_result_t result)
 {
@@ -118,6 +165,7 @@ keys_thread(void *arg, wait_result_t result)
 	unsigned errors = 0;
 	(void)arg;
 	(void)result;
+	keys_pon_pull_up();
 	for (;;) {
 		uint8_t pon = 0, gpio = 0;
 		bool got = keys_use_lock && sweet_spmi_keys_take();
