diff --git a/bsd/dev/beryllium_wlan.c b/bsd/dev/beryllium_wlan.c
index 706de3e..c3a379d 100644
--- a/bsd/dev/beryllium_wlan.c
+++ b/bsd/dev/beryllium_wlan.c
@@ -6389,6 +6389,17 @@ sta_set_state(int s)
 
 static void sta_ps_mode(uint32_t on, const char *what);
 
+/*
+ * 3103: join failure tests, boot-arg wlft (bits, default 0 = off). A failed authentication left the firmware
+ * holding every later management frame until a reboot (status 1 at PEER_DELETE, both bands).
+ * 1 = the first join of the boot goes to a wrong BSSID, so it fails the same way on demand
+ * 2 = no "power save on" after the teardown of a failed join
+ * 4 = delete and create the vdev after the teardown of a failed join
+ * 8 = the first join of the boot prefers 5 GHz
+ */
+static uint32_t sta_wlft;
+static bool sta_wlft_done, sta_join_failed;
+
 /* tear down whatever was set up (ST_DOWN does it in steps); the result stays (a failed join reports it) */
 static void
 sta_teardown_start(uint16_t reason)
@@ -6447,6 +6458,7 @@ static void
 sta_fail(int result, const char *why)
 {
 	printf("SWEET WLAN sta: join FAILED in %s: %s (result %d)\n", st_name[sta.state], why, result);
+	sta_join_failed = true;
 	ipc_note(" sta FAIL %s/%d;", st_name[sta.state], result);
 	lck_mtx_lock(&sta_lock);
 	bool report = !sta.req_pending;
@@ -6480,14 +6492,20 @@ sta_pick_bss(void)
 		if (has_rsn != (sta.req.rsn_ie_len != 0)) {
 			continue;
 		}
-		if (b->rssi > best_rssi) {
+		int score = b->rssi + (((sta_wlft & 8) && !sta_wlft_done && b->mhz > 4900) ? 200 : 0);
+		if (score > best_rssi) {
 			best = (int)i;
-			best_rssi = b->rssi;
+			best_rssi = score;
 		}
 	}
 	if (best >= 0 && sweet_wlan_bss_get((unsigned)best, b) == 0) {
 		sta.bss = best;
 		memcpy(sta.bssid, b->bssid, 6);
+		if ((sta_wlft & 1) && !sta_wlft_done) {
+			sta.bssid[5] ^= 0x55;
+			printf("SWEET WLAN sta: wlft: this join goes to a wrong BSSID\n");
+		}
+		sta_wlft_done = true;
 		sta.mhz = b->mhz;
 		sta.beacon_int = b->beacon_int;
 		sta.ap_cap = b->cap;
@@ -6918,7 +6936,25 @@ sta_step(void)
 				printf("SWEET WLAN sta: no VDEV_STOPPED in 2 s (%u WMI commands still queued: dropped)\n", sta.wq_n);
 			}
 			sta.wq_n = 0;
-			sta_ps_mode(1, "power save on (no channel)");   /* 3036: as at VDEV_CREATE */
+			if (sta_join_failed && (sta_wlft & 4)) {
+				static const uint32_t wlp[3][3] = { { 0, 0, 0 }, { 0, 1, 1 }, { 0, 2, 0 } };  /* as scan_step 8-10 */
+				uint8_t wlb[64];
+				uint32_t wld = 0, wlc[5] = { 0, 2, 0, 0, 0 }, wle[3] = { 0, 0x30, 1 };
+				memcpy(&wlc[3], scan_mac, 6);
+				sta_wmi(wlb, scan_cmd(wlb, 0x5002, 87, &wld, 4), "vdev delete");
+				sta_wmi(wlb, scan_cmd(wlb, 0x5001, 86, wlc, 20), "vdev create");
+				sta_wmi(wlb, scan_cmd(wlb, 0x5008, 95, wle, 12), "vdev tx encap");
+				for (unsigned wlk = 0; wlk < 3; wlk++) {
+					sta_wmi(wlb, scan_cmd(wlb, 0x9002, 109, wlp[wlk], 12), "sta power save param");
+				}
+				printf("SWEET WLAN sta: wlft: vdev deleted and created again\n");
+			}
+			if (!(sta_join_failed && (sta_wlft & 2))) {
+				sta_ps_mode(1, "power save on (no channel)");   /* 3036: as at VDEV_CREATE */
+			} else {
+				printf("SWEET WLAN sta: wlft: no power save after the failed join\n");
+			}
+			sta_join_failed = false;
 			sta.vdev_started = false;
 			sta.peer_mapped = false;
 			sta.mgmt_busy = false;
@@ -9979,6 +10015,7 @@ beryllium_wlan_init(void)
 	}
 	(void)PE_parse_boot_argn("sweetwlandelay", &delay_s, sizeof(delay_s));
 	(void)PE_parse_boot_argn("sweetwlanps", &sta_ps_ms, sizeof(sta_ps_ms));
+	(void)PE_parse_boot_argn("wlft", &sta_wlft, sizeof(sta_wlft));
 	/* Bluetooth firmware (stage 2): sweetbtfw=1 (default) downloads rampatch + NVM when the files exist */
 	wl.bt_fw = 1;
 	wl.bt_baud = 3000000;           /* 3200000 is the dtsi max-speed and also has an exact S6 rate */
